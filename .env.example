# ============================================================
# Database — Neon PostgreSQL (замени на свою строку)
# Получить: https://neon.tech → Create project → Copy connection string
# ============================================================
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/furniture_store?sslmode=require"

# ============================================================
# NextAuth (обязательно для авторизации)
# Сгенерировать: openssl rand -base64 32
# ============================================================
AUTH_SECRET="your-secret-key-change-in-production"
AUTH_URL="https://your-app.vercel.app"

# ============================================================
# Cloudinary (для загрузки изображений — опционально)
# ============================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# Оплата (YooKassa / Stripe — опционально)
# ============================================================
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# ============================================================
# Email (SMTP — опционально)
# ============================================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@mebelfabrika.ru"